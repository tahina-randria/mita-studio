generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  budget    String?
  service   String?
  message   String
  source    String   @default("website")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}
